# Reliability Benchmark Core Configuration
PROJECT_NAME="Reliabench"
API_V1_PREFIX="/api/v1"

# Database connection string (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./reliabench.db"

# Harbor Execution Engine Integration (Target Release: v0.25.0)
HARBOR_VERSION_REQUIRED="v0.25.0"
HARBOR_BIN_PATH="harbor"

# Maxim Bifrost Model Gateway (Optional)
ENABLE_BIFROST_GATEWAY=false
BIFROST_ENDPOINT="http://localhost:8080/v1"

# Artifact Storage
ARTIFACTS_DIR="./artifacts"

